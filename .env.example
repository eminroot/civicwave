# ============================================================
# CivicWave — environment variable reference (master template)
# ------------------------------------------------------------
# This is a documentation-only template covering all three apps.
# Each component reads its OWN local file — copy the relevant block:
#   • Mobile app  -> ZengeZur/civicwave/.env
#   • Telegram bot -> ZengeZur/telegram-bot/.env
#   • Web dashboard -> firebase-config.js / gemini-config.js (static, see below)
# Real .env files are git-ignored and must never be committed.
# ============================================================

# ---------- Mobile app (Expo / React Native) ----------
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# The native Google Maps key is set in ZengeZur/civicwave/app.json (ios/android config).

# ---------- Telegram bot (Node.js) ----------
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# ---------- Web dashboard (static site) ----------
# The static dashboard has no build step, so it reads config from JS files:
#   cp ZengeZurwebsite/firebase-config.example.js ZengeZurwebsite/firebase-config.js
#   cp ZengeZurwebsite/gemini-config.example.js   ZengeZurwebsite/gemini-config.js
# then fill in the placeholders in those copies.
