# Mobile app (Expo): copy to `.env` and fill in. Expo bakes every EXPO_PUBLIC_* value
# into the app when it bundles, so restart `npx expo start` after changing this file.

# The CivicWave server that stores reports and photos. While testing with Expo Go, use
# this PC's Wi-Fi address and the server's port; in production, its https address.
EXPO_PUBLIC_API_URL=http://192.168.1.67:8090

# AIDIN (the photo check and the chat) runs on that server with its OpenAI key, set in
# server/.env as OPENAI_API_KEY. The app itself holds no AI key.
