{
  "expo": {
    "name": "CivicWave",
    "slug": "civicwave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "civicwave",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Müraciətinizin dəqiq yerini təyin etmək üçün məkanınıza icazə lazımdır.",
        "NSCameraUsageDescription": "Problemin şəklini çəkmək üçün kameraya icazə lazımdır.",
        "NSPhotoLibraryUsageDescription": "Problemin şəklini seçmək üçün qalereyaya icazə lazımdır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C64F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 124,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/logo-mark.png",
            "imageWidth": 124,
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Müraciətinizin dəqiq yerini təyin etmək üçün məkanınıza icazə lazımdır."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Problemin şəklini çəkmək üçün kameraya icazə lazımdır.",
          "photosPermission": "Problemin şəklini seçmək üçün qalereyaya icazə lazımdır."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
