# Copy to .env and fill in. Real environment variables override this file.

# Port the server listens on (put Caddy or nginx in front of it in production).
PORT=8090

# Where the SQLite database and the uploaded photos are kept. Back this folder up.
DATA_DIR=data

# The command center website, served at "/".
WEB_DIR=../ZengeZurwebsite

# Public address, used to build absolute photo URLs, e.g. https://civicwave.example.az
PUBLIC_URL=

# Biggest photo accepted, in megabytes.
MAX_UPLOAD_MB=12

# Staff key for the command center. When set, the dashboard asks for it once and the
# report list, the photos and every staff action need it. Leave empty only on a
# private network.
STAFF_KEY=

# Set to 1 behind a reverse proxy, so client IPs and https are read from its headers.
TRUST_PROXY=0

# OpenAI key for AIDIN: the chat in the app, the chat on the website, the check of the
# citizen's photo and of the manager's "fixed" photo. The key stays on this server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional, older: Gemini for the "fixed" photo check when no OpenAI key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
