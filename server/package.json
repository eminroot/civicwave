{
  "name": "civicwave-server",
  "version": "1.0.0",
  "private": true,
  "description": "CivicWave server: stores citizen reports and their photos, and serves the command center website.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
